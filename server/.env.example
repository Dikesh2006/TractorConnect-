# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/tractorconnect

# Client Origin (CORS allowlist)
CLIENT_URL=http://localhost:5173

# Authentication (JWT)
# Must be at least 32 characters in production
JWT_SECRET=super_secret_tractor_connect_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used during npm run seed)
ADMIN_MOBILE=9876543210
ADMIN_PASSWORD=Admin@Tractor2025
ADMIN_NAME=Ramesh Sharma (Admin)

# Business Details
BUSINESS_NAME=TractorConnect Rural Services
BUSINESS_PHONE=9876543210
BUSINESS_UPI_ID=tractorconnect@okhdfcbank
BUSINESS_STATE=Madhya Pradesh
BUSINESS_DISTRICT=Sehore

# Geocoding Base URL
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Razorpay Payment Integration (Optional: false by default)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
